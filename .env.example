# SoftobroCashBook Environment Configuration Example
SECRET_KEY=change-this-to-a-secure-random-key-in-production
DEBUG=False
ALLOWED_HOSTS=softobrocashbook.com,www.softobrocashbook.com,localhost,127.0.0.1

# Central Database (PostgreSQL)
CENTRAL_DB_ENGINE=django.db.backends.postgresql
CENTRAL_DB_NAME=softobrocashbook_central
CENTRAL_DB_USER=your_db_user
CENTRAL_DB_PASSWORD=your_db_password
CENTRAL_DB_HOST=localhost
CENTRAL_DB_PORT=5432

# Tenant Database Provisioning Settings
TENANT_DB_HOST=localhost
TENANT_DB_PORT=5432
TENANT_DB_SUPER_USER=your_postgres_admin
TENANT_DB_SUPER_PASSWORD=your_postgres_admin_password
TENANT_DB_PREFIX=scb_tenant_

# Security & Encryption (Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=replace_with_fernet_key

# bKash Payment Settings
BKASH_COMPANY_NUMBER=017XXXXXXXX
BKASH_ACCOUNT_TYPE=Merchant
BKASH_INSTRUCTIONS=Send Money or Payment to the bKash number above. Copy the Transaction ID (TrxID) and enter it below along with an optional payment screenshot.

# App Settings
SITE_NAME=SoftobroCashBook
SUPPORT_EMAIL=support@softobrocashbook.com
SUPPORT_PHONE=+880 1700-000000
CURRENCY_SYMBOL=BDT

